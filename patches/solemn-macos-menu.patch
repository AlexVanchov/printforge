 @interface SolWvDelegate : NSObject <NSApplicationDelegate, NSWindowDelegate>
 @end
 
+/* A standard macOS menu bar. Without one, AppKit routes no key equivalents:
+ * Cmd+Q, Cmd+W, Cmd+M and the Edit shortcuts (Cmd+C/V/X/A/Z inside text
+ * fields of the page) would all be dead. Edit actions go down the responder
+ * chain to the WKWebView, which forwards them to the page. */
+static NSMenuItem *sol_wv_item(NSMenu *menu, NSString *title, SEL action,
+                               NSString *key, NSEventModifierFlags mods) {
+  NSMenuItem *it = [menu addItemWithTitle:title action:action keyEquivalent:key];
+  it.keyEquivalentModifierMask = mods;
+  return it;
+}
+
+static void sol_wv_build_menu(NSString *appName) {
+  NSMenu *bar = [[NSMenu alloc] init];
+  NSEventModifierFlags cmd = NSEventModifierFlagCommand;
+
+  NSMenuItem *appItem = [[NSMenuItem alloc] init];
+  [bar addItem:appItem];
+  NSMenu *appMenu = [[NSMenu alloc] initWithTitle:appName];
+  sol_wv_item(appMenu, [@"About " stringByAppendingString:appName],
+              @selector(orderFrontStandardAboutPanel:), @"", 0);
+  [appMenu addItem:[NSMenuItem separatorItem]];
+  sol_wv_item(appMenu, [@"Hide " stringByAppendingString:appName],
+              @selector(hide:), @"h", cmd);
+  sol_wv_item(appMenu, @"Hide Others", @selector(hideOtherApplications:),
+              @"h", cmd | NSEventModifierFlagOption);
+  sol_wv_item(appMenu, @"Show All", @selector(unhideAllApplications:), @"", 0);
+  [appMenu addItem:[NSMenuItem separatorItem]];
+  sol_wv_item(appMenu, [@"Quit " stringByAppendingString:appName],
+              @selector(terminate:), @"q", cmd);
+  appItem.submenu = appMenu;
+
+  NSMenuItem *editItem = [[NSMenuItem alloc] init];
+  [bar addItem:editItem];
+  NSMenu *edit = [[NSMenu alloc] initWithTitle:@"Edit"];
+  sol_wv_item(edit, @"Undo", NSSelectorFromString(@"undo:"), @"z", cmd);
+  sol_wv_item(edit, @"Redo", NSSelectorFromString(@"redo:"), @"z",
+              cmd | NSEventModifierFlagShift);
+  [edit addItem:[NSMenuItem separatorItem]];
+  sol_wv_item(edit, @"Cut", @selector(cut:), @"x", cmd);
+  sol_wv_item(edit, @"Copy", @selector(copy:), @"c", cmd);
+  sol_wv_item(edit, @"Paste", @selector(paste:), @"v", cmd);
+  sol_wv_item(edit, @"Select All", @selector(selectAll:), @"a", cmd);
+  editItem.submenu = edit;
+
+  NSMenuItem *viewItem = [[NSMenuItem alloc] init];
+  [bar addItem:viewItem];
+  NSMenu *view = [[NSMenu alloc] initWithTitle:@"View"];
+  sol_wv_item(view, @"Enter Full Screen", @selector(toggleFullScreen:), @"f",
+              cmd | NSEventModifierFlagControl);
+  viewItem.submenu = view;
+
+  NSMenuItem *winItem = [[NSMenuItem alloc] init];
+  [bar addItem:winItem];
+  NSMenu *win = [[NSMenu alloc] initWithTitle:@"Window"];
+  sol_wv_item(win, @"Minimize", @selector(performMiniaturize:), @"m", cmd);
+  sol_wv_item(win, @"Zoom", @selector(performZoom:), @"", 0);
+  [win addItem:[NSMenuItem separatorItem]];
+  sol_wv_item(win, @"Close Window", @selector(performClose:), @"w", cmd);
+  winItem.submenu = win;
+
+  [NSApp setMainMenu:bar];
+  [NSApp setWindowsMenu:win];
+}
+
