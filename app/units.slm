# units — friendly length input and output.
#
# Internally every length is millimetres. People type sizes the way they
# think about them: "25", "25mm", "2.5 cm", "1in", "3/4\"", "1 1/2 in",
# "1in + 5mm". parse_length turns any of those into millimetres, or a plain
# sentence explaining what went wrong.

import "fmath.slm"
import "textutil.slm"

type Scan = { ok: Bool, v: Float, pos: Int }

fn unit_factor(unit: Text) -> Float {
  example unit_factor("mm") == 1.0
  example unit_factor("in") == 25.4
  example unit_factor("cm") == 10.0
  example unit_factor("parsec") == 0.0

  if unit == "mm" {
    return 1.0
  }
  if unit == "cm" {
    return 10.0
  }
  if unit == "m" {
    return 1000.0
  }
  if unit == "in" {
    return 25.4
  }
  if unit == "ft" {
    return 304.8
  }
  return 0.0
}

fn unit_decimals(unit: Text) -> Int {
  example unit_decimals("mm") == 2
  example unit_decimals("in") == 3

  if unit == "in" or unit == "ft" {
    return 3
  }
  if unit == "m" {
    return 4
  }
  return 2
}

fn skip_ws(b: Bytes, i: Int) -> Int {
  var p: Int = i
  while p < len(b) and textutil.is_space(textutil.byte_at(b, p)) {
    p = p + 1
  }
  return p
}

# Unsigned decimal: digits [ "." digits ] or "." digits.
fn scan_decimal(b: Bytes, i: Int) -> Scan {
  var p: Int = i
  var v: Float = 0.0
  var digits: Int = 0
  while textutil.is_digit(textutil.byte_at(b, p)) {
    v = v * 10.0 + to_float(textutil.byte_at(b, p) - 48)
    p = p + 1
    digits = digits + 1
  }
  if textutil.byte_at(b, p) == 46 or textutil.byte_at(b, p) == 44 {
    var scale: Float = 0.1
    var q: Int = p + 1
    var fd: Int = 0
    while textutil.is_digit(textutil.byte_at(b, q)) {
      v = v + scale * to_float(textutil.byte_at(b, q) - 48)
      scale = scale / 10.0
      q = q + 1
      fd = fd + 1
    }
    if fd > 0 {
      p = q
      digits = digits + fd
    }
  }
  if digits == 0 {
    return Scan { ok: false, v: 0.0, pos: i }
  }
  return Scan { ok: true, v: v, pos: p }
}

# A whole number, a decimal, a fraction "3/4", or a mixed number "1 1/2".
fn scan_number(b: Bytes, i: Int) -> Scan {
  let first: Scan = scan_decimal(b, i)
  if not first.ok {
    return first
  }
  # simple fraction right after the number: 3/4
  if textutil.byte_at(b, first.pos) == 47 {
    let den: Scan = scan_decimal(b, first.pos + 1)
    if den.ok and den.v > 0.0 {
      return Scan { ok: true, v: first.v / den.v, pos: den.pos }
    }
    return Scan { ok: false, v: 0.0, pos: first.pos }
  }
  # mixed number: 1 1/2
  let after: Int = skip_ws(b, first.pos)
  if after > first.pos {
    let num: Scan = scan_decimal(b, after)
    if num.ok and textutil.byte_at(b, num.pos) == 47 {
      let den2: Scan = scan_decimal(b, num.pos + 1)
      if den2.ok and den2.v > 0.0 {
        return Scan { ok: true, v: first.v + num.v / den2.v, pos: den2.pos }
      }
    }
  }
  return first
}

fn is_letter(c: Int) -> Bool {
  return (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
}

# The unit word at i as a factor in mm (v = 0.0 means "no unit here").
fn scan_unit(b: Bytes, i: Int) -> Scan {
  let p: Int = skip_ws(b, i)
  let c: Int = textutil.byte_at(b, p)
  if c == 34 {
    return Scan { ok: true, v: 25.4, pos: p + 1 }
  }
  if c == 39 {
    return Scan { ok: true, v: 304.8, pos: p + 1 }
  }
  var q: Int = p
  var word: Text = ""
  while is_letter(textutil.byte_at(b, q)) {
    word = word + textutil.ascii_char(textutil.lower_byte(textutil.byte_at(b, q)))
    q = q + 1
  }
  if word == "" {
    return Scan { ok: true, v: 0.0, pos: i }
  }
  if word == "mm" or word == "millimeter" or word == "millimeters" or word == "millimetre" or word == "millimetres" {
    return Scan { ok: true, v: 1.0, pos: q }
  }
  if word == "cm" or word == "centimeter" or word == "centimeters" or word == "centimetre" or word == "centimetres" {
    return Scan { ok: true, v: 10.0, pos: q }
  }
  if word == "m" or word == "meter" or word == "meters" or word == "metre" or word == "metres" {
    return Scan { ok: true, v: 1000.0, pos: q }
  }
  if word == "in" or word == "inch" or word == "inches" {
    return Scan { ok: true, v: 25.4, pos: q }
  }
  if word == "ft" or word == "foot" or word == "feet" {
    return Scan { ok: true, v: 304.8, pos: q }
  }
  return Scan { ok: false, v: 0.0, pos: p }
}

# Parse a length typed by a person into millimetres. `unit` is the unit
# assumed for bare numbers (the user's display unit).
fn parse_length(t: Text, unit: Text) -> Result[Float, Text] {
  example parse_length("25", "mm") == Ok(25.0)
  example parse_length(" 25 mm ", "in") == Ok(25.0)
  example parse_length("2.5cm", "mm") == Ok(25.0)
  example parse_length("1in", "mm") == Ok(25.4)
  example parse_length("2", "in") == Ok(50.8)
  example parse_length("3/4\"", "mm") == Ok(19.05)
  example parse_length("1 1/2 in", "mm") == Ok(38.1)
  example parse_length("1in + 5mm", "mm") == Ok(30.4)
  example parse_length("10 - 2.5", "mm") == Ok(7.5)
  example parse_length("12,5", "mm") == Ok(12.5)
  example parse_length(".5in", "mm") == Ok(12.7)
  example parse_length("", "mm") == Err("Type a size, for example 25 or 1.5 in")
  example parse_length("abc", "mm") == Err("That is not a number. Try something like 25 or 1.5 in")
  example parse_length("5 parsecs", "mm") == Err("Unknown unit. Use mm, cm, m, in or ft")
  example parse_length("1/0", "mm") == Err("That is not a number. Try something like 25 or 1.5 in")

  let b: Bytes = text_to_bytes(t)
  var p: Int = skip_ws(b, 0)
  if p >= len(b) {
    return Err("Type a size, for example 25 or 1.5 in")
  }
  let dflt: Float = unit_factor(unit)
  if dflt == 0.0 {
    return Err("Unknown unit. Use mm, cm, m, in or ft")
  }
  var total: Float = 0.0
  var sign: Float = 1.0
  var first: Bool = true
  while p < len(b) {
    if not first {
      let op: Int = textutil.byte_at(b, p)
      if op == 43 {
        sign = 1.0
      } else if op == 45 {
        sign = -1.0
      } else {
        return Err("That is not a number. Try something like 25 or 1.5 in")
      }
      p = skip_ws(b, p + 1)
    } else if textutil.byte_at(b, p) == 45 {
      sign = -1.0
      p = skip_ws(b, p + 1)
    }
    let n: Scan = scan_number(b, p)
    if not n.ok {
      return Err("That is not a number. Try something like 25 or 1.5 in")
    }
    let u: Scan = scan_unit(b, n.pos)
    if not u.ok {
      return Err("Unknown unit. Use mm, cm, m, in or ft")
    }
    var factor: Float = u.v
    if factor == 0.0 {
      factor = dflt
    }
    total = total + sign * n.v * factor
    p = skip_ws(b, u.pos)
    first = false
  }
  return Ok(fmath.roundf(total * 1000000.0) / 1000000.0)
}

# A length for display: "25.4 mm", "1 in".
fn format_length(mm: Float, unit: Text) -> Text {
  example format_length(25.4, "in") == "1 in"
  example format_length(25.4, "mm") == "25.4 mm"
  example format_length(12.0, "cm") == "1.2 cm"
  example format_length(10.0, "furlong") == "10 mm"

  let f: Float = unit_factor(unit)
  if f == 0.0 {
    return fmath.fmt(mm, 2) + " mm"
  }
  return fmath.fmt(mm / f, unit_decimals(unit)) + " " + unit
}
